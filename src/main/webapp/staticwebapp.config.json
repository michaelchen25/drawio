{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/connect/*",
      "/custom-config/*",
      "/custom-libraries/*",
      "/images/*",
      "/img/*",
      "/js/*",
      "/math4/*",
      "/mxgraph/*",
      "/plugins/*",
      "/resources/*",
      "/shapes/*",
      "/stencils/*",
      "/styles/*",
      "/templates/*",
      "/*.css",
      "/*.gif",
      "/*.html",
      "/*.ico",
      "/*.js",
      "/*.json",
      "/*.map",
      "/*.png",
      "/*.svg",
      "/*.txt"
    ]
  },
  "globalHeaders": {
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff"
  },
  "mimeTypes": {
    ".drawio": "application/xml",
    ".mjs": "text/javascript"
  }
}
